{
  "name": "rankrise",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "vite",
    "dev:php": "php -d opcache.enable=0 -d opcache.enable_cli=0 -S 127.0.0.1:8080 -t public public/api/router-dev.php",
    "dev:local": "node scripts/dev-local.mjs",
    "build": "vite build && node scripts/sanitize-dist.mjs && node scripts/verify-dist-api.mjs",
    "build:public_html": "npm run build && node scripts/prepare-public-html.mjs",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@paypal/react-paypal-js": "^9.0.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.12",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.552.0",
    "next-themes": "^0.4.6",
    "prop-types": "^15.8.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.5",
    "react-simple-maps": "^1.0.0",
    "sonner": "^2.0.7",
    "swiper": "^12.1.4",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "postcss": "^8.5.6",
    "puppeteer": "^24.43.1",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^6.2.0",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "esbuild@0.25.12": true
  }

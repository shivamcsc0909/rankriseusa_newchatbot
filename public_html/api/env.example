# RankRise PHP API environment (Phase 3–4)
# Copy to public/api/.env on the server (never commit real secrets).

APP_NAME="RankRise API"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://rankriseusa.com
APP_TIMEZONE=UTC

LOG_LEVEL=info
LOG_CHANNEL=app

# MySQL (Hostinger Shared Hosting)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u834013214_rrr
DB_USERNAME=u834013214_rrr
DB_PASSWORD=123mshgdhd0%$#@F
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Admin API authentication (X-Admin-Key)
ADMIN_API_KEY=RankRiseAdmin2026!
ADMIN_API_HEADER=X-Admin-Key

# CORS
CORS_ALLOWED_ORIGINS=https://rankriseusa.com,https://www.rankriseusa.com
CORS_ALLOW_LOCALHOST=false
CORS_MAX_AGE=86400

JSON_BODY_LIMIT_BYTES=1048576

# Polling defaults (used by later chat phase)
POLL_VISITOR_INTERVAL_MS=2000
POLL_ADMIN_INTERVAL_MS=1500
PRESENCE_TTL_SECONDS=30
TYPING_TTL_SECONDS=5

# Knowledge Base JSON collections (Phase 4 AI search)
# Defaults to public/api/storage/knowledge
KB_DATA_DIR=

# Chat JSON persistence (Phase 5 polling)
CHAT_DATA_DIR=

# OpenAI (public/api/.env) — REQUIRED for AI replies; no fallback key
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=30000
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2
OPENAI_RETRY_BASE_DELAY_MS=500

# PayPal (create-order.php / capture-order.php) — REQUIRED; no placeholders
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_API=https://api-m.paypal.com
